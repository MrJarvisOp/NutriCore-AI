# ─── LLM (Groq - free tier: https://console.groq.com) ───────────────────────
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.1-8b-instant
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3

# ─── Tavily Web Search (free tier: https://app.tavily.com) ──────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ─── App ─────────────────────────────────────────────────────────────────────
DEBUG=false

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./diet_health.db
# DATABASE_URL=postgresql://user:password@localhost:5432/diet_health

# ─── OCR ─────────────────────────────────────────────────────────────────────
TESSERACT_CMD=/usr/bin/tesseract
